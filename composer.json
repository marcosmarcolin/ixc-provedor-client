{
  "name": "marcosmarcolin/ixc-provedor-client",
  "description": "Cliente PHP para a API webservice do IXC Provedor (IXCSoft)",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "ixc",
    "ixcsoft",
    "ixc-soft",
    "ixc-provedor",
    "api",
    "api-client",
    "webservice",
    "psr-18",
    "isp",
    "provedor"
  ],
  "homepage": "https://github.com/marcosmarcolin/ixc-provedor-client",
  "authors": [
    {
      "name": "Marcos Marcolin",
      "email": "marcolindev@gmail.com",
      "homepage": "https://www.marcosmarcolin.com.br",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/marcosmarcolin/ixc-provedor-client/issues",
    "source": "https://github.com/marcosmarcolin/ixc-provedor-client",
    "docs": "https://wikiapiprovedor.ixcsoft.com.br"
  },
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "php-http/discovery": "^1.19",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8",
    "php-http/mock-client": "^1.6",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "suggest": {
    "nyholm/psr7": "PSR-17 factories, discovered automatically (guzzlehttp/psr7 works too)",
    "guzzlehttp/guzzle": "To use Guzzle instead of the built-in client, with Client::withHttpClient()"
  },
  "autoload": {
    "psr-4": {
      "Marcolin\\IxcProvedor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Marcolin\\IxcProvedor\\Tests\\": "tests/",
      "Marcolin\\IxcProvedor\\Tools\\": "tools/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "coverage": [
      "phpunit --colors=never --coverage-text --coverage-clover build/coverage.xml",
      "php tools/check-coverage.php build/coverage.xml 95"
    ],
    "capture": "php tools/capture-fixtures.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
