{
  "name": "marcosmarcolin/ixc-provedor-client",
  "description": "PHP client for the IXC Provedor (IXCSoft) webservice API",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "ixc",
    "ixcsoft",
    "ixc-provedor",
    "api",
    "webservice",
    "isp"
  ],
  "authors": [
    {
      "name": "Marcos Marcolin"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "php-http/discovery": "^1.19",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8",
    "php-http/mock-client": "^1.6",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "Marcolin\\IxcProvedor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Marcolin\\IxcProvedor\\Tests\\": "tests/",
      "Marcolin\\IxcProvedor\\Tools\\": "tools/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "capture": "php tools/capture-fixtures.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
